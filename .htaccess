# Subfolder bridge: when domain document root is project root,
# this exposes /public as site root and blocks direct access
# to sensitive project folders/files.

RewriteEngine On

RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^(app|config|database|vendor)(/|$) - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^\.env$ - [F,L]

# Serve everything else from /public without visible redirect.
RewriteRule ^(.*)$ public/$1 [L]
